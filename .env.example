# EmailJS Configuration for "A Letter for Ananya"
# Sign up at https://www.emailjs.com/ to retrieve these values

# 1. Email Service ID (e.g., service_xxxxxxx from Email Services tab)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. Email Template ID (e.g., template_xxxxxxx from Email Templates tab)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# 3. Account Public Key (e.g., user_xxxxxxxx or public key from Account > General tab)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Umami Analytics Configuration (https://umami.is)
# Cloud script URL: https://cloud.umami.is/script.js (or your custom domain)
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Website Tracking ID from Umami Dashboard > Websites > Edit > Website ID
VITE_UMAMI_WEBSITE_ID=your_website_id_here
